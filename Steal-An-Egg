local translated = {}local lastScan = 0 local scanInterval = 5 local function shouldTranslateGui(gui)
return (gui:IsA("TextLabel") or gui:IsA("TextButton") or gui:IsA("TextBox")) and not translated[gui]end 
local function translateGui(gui)pcall(function() local text = gui.Text
if text and text ~= "" and #text < 1000 then local translatedText = translateText(text)
if translatedText ~= text then gui.Text = translatedText translated[gui] = true end end end)end   
local function scanAndTranslate()local now = tick()
if now - lastScan < scanInterval then return end lastScan = now
local batch = {}local batchSize = 50  for _, gui in ipairs(game:GetService("CoreGui"):GetDescendants()) do
if shouldTranslateGui(gui) then table.insert(batch, gui)
if #batch >= batchSize then
for _, g in ipairs(batch) do translateGui(g)end batch = {} task.wait()end end end
for _, g in ipairs(batch) do translateGui(g)end
local player = game:GetService("Players").LocalPlayer if player and player:FindFirstChild("PlayerGui") then batch = {}
for _, gui in ipairs(player.PlayerGui:GetDescendants()) do if shouldTranslateGui(gui) then table.insert(batch, gui)
if #batch >= batchSize then for _, g in ipairs(batch) do translateGui(g)
end batch = {}task.wait()end end end
for _, g in ipairs(batch) do translateGui(g)end end end   
